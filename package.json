{
  "name": "portfolio-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:db": "node tests/check-db.mjs",
    "test": "node --no-warnings --import ./tests/register-alias.mjs --test tests/*.test.mts",
    "test:smoke": "node tests/smoke-e2e.mjs",
    "ci": "npm run check:db && npm run typecheck && npm test && npm run build && npm run test:smoke"
  },
  "overrides": {
    "postcss": "^8.5.32"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "tailwindcss": "^4.1.7",
    "typescript": "^7.0.2"
  }
}
