# Yönetim paneli giriş şifresi (Canlı ortamda en az 12 karakterli güçlü bir şifre belirleyin!)
ADMIN_PASSWORD=buraya-cok-guclu-bir-sifre-yazin

# Oturum (Session) imzalama anahtarı (En az 32 karakterli rastgele bir dize)
SESSION_SECRET=buraya-rastgele-en-az-32-karakterli-gizli-anahtar-yazin

# OPSİYONEL: Vercel gibi sunucusuz (serverless) ortamlarda canlı yönetim panelinden
# yapılan değişikliklerin kalıcı olarak GitHub deponuza kaydedilmesi için:
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GITHUB_REPO=suleymanibis/potfolio-and-apps-website
# GITHUB_BRANCH=main
